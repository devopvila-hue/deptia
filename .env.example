# Site
NEXT_PUBLIC_SITE_URL=https://dept.ia
NEXT_PUBLIC_SITE_NAME=DEPT.IA

# Auth provider
NEXT_PUBLIC_AUTH_PROVIDER=supabase

# Supabase — these values are PUBLIC, safe to ship to the browser.
# They identify the project; they do NOT grant write privileges beyond RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — NEVER expose service_role to the browser.
# Used by /api routes that need elevated privileges (admin tasks, webhooks).
SUPABASE_SERVICE_ROLE_KEY=

# Payments (placeholder for future Stripe integration)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Provisioning API (backend placeholder)
PROVISIONING_API_URL=
PROVISIONING_API_KEY=

# Analytics (placeholder — pick one when ready)
NEXT_PUBLIC_ANALYTICS_PROVIDER=posthog
NEXT_PUBLIC_ANALYTICS_KEY=

# Feature flags
NEXT_PUBLIC_ENABLE_BILLING_CYCLE=true
NEXT_PUBLIC_ENABLE_DEMO=true
NEXT_PUBLIC_ENABLE_SELF_SERVE_REGISTRATION=true
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=